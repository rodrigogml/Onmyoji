# O repositório ocupa a raiz do CODEX_HOME. Ignore qualquer arquivo novo por
# padrão e libere somente a superfície versionável do Shikigami.
/*

# Identidade, instruções e administração da instância
!/.gitignore
!/README.md
!/AGENTS.md
!/instructions.md
!/environment.toml
!/*.proposed.md
!/setupOnmyoji.py

# Documentação e recursos próprios da instância
!/docs/
!/docs/**
!/etc/
!/etc/**

# Fontes versionáveis de skills específicas da instância
!/shikigami-skills/
!/shikigami-skills/**

# Perfis opcionais de subagentes; somente arquivos TOML são fontes
!/shikigami-agents/
/shikigami-agents/*
!/shikigami-agents/*.toml

# Arquivos próprios do Shikigami, em uma pasta nomeada <nome>-files
!/*-files/
!/*-files/**

# Preserve somente os diretórios locais versionados como sentinelas. Configuração,
# estado, temporários e o runtime Python nunca pertencem ao repositório.
!/configs/
/configs/*
!/configs/.gitkeep
!/state/
/state/*
!/state/.gitkeep
!/tmp/
/tmp/*
!/tmp/.gitkeep
!/venv/
/venv/*
!/venv/.gitkeep
