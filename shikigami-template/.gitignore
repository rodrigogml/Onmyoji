# O repositório ocupa a raiz do CODEX_HOME. Ignore qualquer arquivo novo por
# padrão e libere somente as fontes que pertencem à instância do Shikigami.
/*

# Identidade e instruções versionadas da instância
!/.gitignore
!/README.md
!/AGENTS.md
!/instructions.md
!/environment.toml
!/*.proposed.md

# Fontes versionáveis de skills específicas da instância
!/shikigami-skills/
!/shikigami-skills/**

# Perfis opcionais de subagentes; somente arquivos TOML são fontes
!/shikigami-agents/
/shikigami-agents/*
!/shikigami-agents/*.toml
