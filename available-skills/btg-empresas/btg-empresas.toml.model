schema_version = 1

[defaults]
timeout_seconds = 30

# Configure pelo setup. Use uma entrada KeePass dedicada com acesso read_write.
# password=client_secret; notes é administrado como JSON OAuth pelo wrapper.
[profiles.example]
environment = "sandbox"
company_id = "30306294000145"
# O callback consulta a API e salva account_id, account_number e branch_code.
# Número/agência vazios permitem descoberta; preencha somente para filtrar múltiplas contas.
account_number = ""
branch_code = ""
workspace = "C:/opt/Shikigami-Exemplo-Work"
vault_profile = "PREENCHER_PERFIL_KEEPASS"
vault_entry_path = "Integrations/BTG/example"
client_id = "PREENCHER_CLIENT_ID"
redirect_uri = "https://miniapps.example.com/oauth/skills/btg-empresas/callback"
oauth_mode = "remote"
scopes = "openid empresas.btgpactual.com/accounts.readonly brn:btg:empresas:banking:payments brn:btg:empresas:banking:direct-debit"
max_amount = "1000000.00"
monitor_enabled = false
