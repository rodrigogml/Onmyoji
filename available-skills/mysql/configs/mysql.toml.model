schema_version = 1
[defaults]
executable = "mysql"
port = 3306
connect_timeout = 10
timeout_seconds = 120
allow_client_commands = true
[profiles.example]
host = "127.0.0.1"
database = "example"
user = ""
vault_profile = "example"
vault_entry_path = "APIs/MySQL:usuario"
username_field = "username"
password_field = "password"
