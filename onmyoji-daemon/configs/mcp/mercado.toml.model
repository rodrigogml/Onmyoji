schema_version = 1

[defaults]
timeout_seconds = 30
max_retries = 2
page_size = 50
max_page_size = 100
max_response_bytes = 10485760
max_report_bytes = 104857600
report_cache_ttl_seconds = 900

[applications.mercadolivre.example]
environment = "production"
credential_profile = "example"
credential_entry_path = "Integrations/MercadoLivre/Applications/example"
redirect_uri = "https://apps.example.com/oauth/mcp/mercadolivre/callback"
scopes = ["read", "write", "offline_access"]

[applications.mercadopago.example]
environment = "production"
credential_profile = "example"
credential_entry_path = "Integrations/MercadoPago/Applications/example"
redirect_uri = "https://apps.example.com/oauth/mcp/mercadopago/callback"
scopes = ["read", "write", "offline_access"]

[profiles.example]
enabled = true
description = "Explique quando este perfil Mercado deve ser utilizado."
modules = ["mercadolivre.account", "mercadolivre.purchases", "mercadolivre.shipping", "mercadopago.payments", "mercadopago.reports"]

[profiles.example.mercadolivre]
application = "example"
site_id = "MLB"
auth_mode = "authorization_code"
authorization_credential_profile = "example"
authorization_entry_path = "Integrations/MercadoLivre/Authorizations/example"

[profiles.example.mercadopago]
application = "example"
site_id = "MLB"
auth_mode = "authorization_code"
authorization_credential_profile = "example"
authorization_entry_path = "Integrations/MercadoPago/Authorizations/example"
