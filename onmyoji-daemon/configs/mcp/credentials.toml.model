schema_version = 1

[defaults]
timeout_seconds = 30

[vaults.main]
cli_command = ["keepassxc-cli"]

[vaults.main.database]
windows = "C:/caminho/para/cofre.kdbx"
linux = "/caminho/para/cofre.kdbx"

[profiles.example]
vault = "main"
allowed_entry_roots = ["APIs"]

[profiles.example.auth.windows]
mode = "windows_credential_manager"
target = "Onmyoji/MCP/KeePass/example"

[profiles.example.auth.linux]
mode = "command"
command = ["secret-tool", "lookup", "service", "onmyoji-mcp", "profile", "example"]
