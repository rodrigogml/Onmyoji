schema_version = 1

[defaults]
api_base = "https://api.notion.com"
notion_version = "2026-03-11"
timeout_seconds = 30
max_retries = 2
page_size = 100

[profiles.example]
enabled = true
description = "Workspace Notion principal da organização."
credential_profile = "example"
credential_entry_path = "APIs/Notion/example"
credential_field = "password"
readable_roots = ["C:/workspace"]
