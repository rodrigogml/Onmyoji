schema_version = 1
enabled = false

[telegram]
# Perfil KeePass local que contém o token do bot.
keepass_profile = "telegram"
token_entry = "APIs/Telegram:Shikigami"
poll_timeout_seconds = 30

[agent]
# O workspace, modelo, sandbox e aprovação vêm de configs/onmyoji-system.toml.
max_parallel_conversations = 1
turn_timeout_seconds = 900
# Preferências por conversa que owners podem escolher em /config. Listas vazias
# restringem a escolha ao modelo e esforço padrão definidos pelo administrador.
owner_execution_preferences = true
owner_allowed_models = []
owner_allowed_reasoning_efforts = []

[instructions]
# Caminho relativo a shikigami/.
enabled = true
shikigami_file = "instructions.md"

[app_server]
# Mantém um Codex App Server exclusivo desta instância para reutilizar a conversa.
# Deve ser habilitado antes do gateway Telegram; mantém contexto e developer instructions consistentes.
enabled = false
# Encerra o processo quando não houver turnos ativos por este período. As threads persistem.
idle_timeout_seconds = 1800

[limits]
max_attachment_bytes = 20971520
max_batch_attachment_bytes = 52428800
max_pending_items = 50
max_retained_attachment_bytes = 262144000
max_outbound_media_bytes = 20971520
max_outbound_media_per_turn = 3

[voice_reply]
# Disponibiliza voz local ao gateway; a escolha texto/áudio é persistida por conversa.
enabled = false
eccovox_profile = ""
language = "pt-BR"
voice = ""
speed = 1.0
response_format = "mp3"
max_text_characters = 3500
auto_off_minutes = 15
fallback_to_text = true
agent_outbound_media = false

[totp]
enabled = false
real_password_entry = ""
fake_password_entry = ""
period_seconds = 30
