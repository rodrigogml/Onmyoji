schema_version = 1
enabled = false

[telegram]
# Perfil KeePass local que contém o token do bot.
keepass_profile = "telegram"
token_entry = "APIs/Telegram:Shikigami"
poll_timeout_seconds = 30

[agent]
# O workspace, modelo, sandbox e aprovação vêm de configs/onmyoji-system.toml.
max_parallel_conversations = 1
turn_timeout_seconds = 900
developer_file = ""

[app_server]
# Mantém um Codex App Server exclusivo desta instância para reutilizar a conversa.
# Desabilitado por padrão para permitir rollout gradual; o modo legado usa codex exec por turno.
enabled = false
# Encerra o processo quando não houver turnos ativos por este período. As threads persistem.
idle_timeout_seconds = 1800

[limits]
max_attachment_bytes = 20971520
max_batch_attachment_bytes = 52428800
max_pending_items = 50
max_retained_attachment_bytes = 262144000

[totp]
enabled = false
real_password_entry = ""
fake_password_entry = ""
period_seconds = 30
