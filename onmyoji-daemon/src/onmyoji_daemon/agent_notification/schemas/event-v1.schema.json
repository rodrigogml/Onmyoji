{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onmyoji:notification:event:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "prompt", "response_channel", "thread_policy"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "format": "uuid7"},
    "prompt": {"type": "string", "pattern": "\\S"},
    "response_channel": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["telegram", "email"]},
        "value": {"type": "string", "pattern": "\\S"},
        "account": {"type": "string", "pattern": "\\S"},
        "subject": {"type": "string", "pattern": "\\S"}
      },
      "allOf": [{
        "if": {"properties": {"type": {"const": "email"}}, "required": ["type"]},
        "then": {"required": ["account", "subject"]},
        "else": {
          "not": {
            "anyOf": [
              {"required": ["account"]},
              {"required": ["subject"]}
            ]
          }
        }
      }]
    },
    "thread_policy": {"enum": ["new", "reuse"]}
  }
}
