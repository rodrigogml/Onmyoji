# O diretório é um CODEX_HOME de produção: ignore qualquer arquivo novo na raiz.
# Os únicos recursos versionados na raiz são liberados explicitamente abaixo.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/*.proposed.md
!/setupOnmyoji.py
!/bootstrapShikigami.py
!/pytest.ini
!/conftest.py
!/shikigami-template/
!/shikigami-template/**
!/shikigami-skills/
!/shikigami-skills/**
!/shikigami-agents/
!/shikigami-agents/*.toml
!/docs/
!/docs/**
!/etc/
!/etc/ID Visual/
!/etc/ID Visual/logo.png
!/onmyoji-daemon/
!/onmyoji-daemon/**
!/tests/
!/tests/**

# A superfície legada de skills não faz parte da arquitetura atual. Skills gerenciadas
# são materializadas somente no workspace do Shikigami.
/skills/

# Configuração local de uma instância do Onmyōji (CODEX_HOME)
/config.toml
/*.config.toml
!/venv/
/venv/*
!/venv/.gitkeep
!/configs/
/configs/*
!/configs/.gitkeep
/*.bak
/*.bak.*

# Estado, autenticação e caches gerenciados pelo Codex
/auth.json
/sessions/
!/state/
/state/*
!/state/.gitkeep
/log/
!/tmp/
/tmp/*
!/tmp/.gitkeep
/plugins/
/cache/
/thread-writer-locks/
/*.sqlite
/*.sqlite-shm
/*.sqlite-wal

# Artefatos locais de Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
