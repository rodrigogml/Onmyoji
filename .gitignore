# O diretório é um CODEX_HOME de produção: ignore qualquer arquivo novo na raiz.
# Os únicos recursos versionados na raiz são liberados explicitamente abaixo.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/setupOnmyoji.py
!/pytest.ini
!/conftest.py
!/shikigami/
!/shikigami/**
!/docs/
!/docs/**
!/available-skills/
!/available-skills/**
!/onmyoji-daemon/
!/onmyoji-daemon/**
!/tests/
!/tests/**

# Superfície de skills varrida pelo Codex: contém apenas links locais e skills de sistema.
/skills/

# Configuração local de uma instância do Onmyōji (CODEX_HOME)
/config.toml
/*.config.toml
/configs/
/*.bak
/*.bak.*

# Estado, autenticação e caches gerenciados pelo Codex
/auth.json
/sessions/
/state/
/log/
/tmp/
/plugins/
/cache/
/thread-writer-locks/
/*.sqlite
/*.sqlite-shm
/*.sqlite-wal

# Artefatos locais de Python
__pycache__/
*.py[cod]
.pytest_cache/
