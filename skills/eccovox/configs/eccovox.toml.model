schema_version = 1

[defaults]
request_timeout_seconds = 120
max_audio_bytes = 10485760
max_text_characters = 4000

[profiles.example]
# Somente HTTP em loopback é aceito pelo wrapper.
base_url = "http://127.0.0.1:8870"
# Declare explicitamente os diretórios que a skill pode ler e gravar.
readable_roots = []
writable_roots = []
