schema_version = 1
[defaults]
java_path = "java"
timeout_seconds = 180
encoding = "utf-8"
[profiles.example]
jar_path = "C:/opt/BISCMD/BISCMD-9.0.jar"
working_dir = "C:/opt/BISCMD"
host = "127.0.0.1"
port = 8080
vault_profile = "example"
vault_entry_path = "Servidores/BIS2/BISCMD"
username_field = "username"
password_field = "password"
